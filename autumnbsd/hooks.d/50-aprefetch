#!/bin/sh
#
# akture(8) hook shipped by AutumnBSD.  Akture itself knows nothing
# about aprefetch(4); this hook is the whole integration.
#
#	session-started <user> <session>
#		close the boot recording window, as login(1) does through
#		pam_exec(8)
#
# XXX Prefetching the session while the password is typed, on
# greeter-shown and auth-ok, needs a profile per session.  aprefetch
# only has the boot profile and per-application profiles, and the
# latter are not implemented yet; once they are, replay the profile of
# the session here with "aprefctl replay".
#

APREFCTL=/usr/sbin/aprefctl

[ -x "$APREFCTL" ] || exit 0

case "$1" in
session-started)
	exec "$APREFCTL" boot-done
	;;
esac
exit 0
